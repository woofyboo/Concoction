{
  "multipart": [
    { "when": { "age": "0", "up": "true"    }, "apply": { "model": "concoction:custom/saponaria_stage0" } },
    { "when": { "age": "0", "down": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage0", "x": 180 } },
    { "when": { "age": "0", "north": "true" }, "apply": { "model": "concoction:custom/saponaria_stage0", "x": 90 } },
    { "when": { "age": "0", "south": "true" }, "apply": { "model": "concoction:custom/saponaria_stage0", "x": 90, "y": 180 } },
    { "when": { "age": "0", "west": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage0", "x": 90, "y": 270 } },
    { "when": { "age": "0", "east": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage0", "x": 90, "y": 90 } },

    { "when": { "age": "1", "up": "true"    }, "apply": { "model": "concoction:custom/saponaria_stage1" } },
    { "when": { "age": "1", "down": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage1", "x": 180 } },
    { "when": { "age": "1", "north": "true" }, "apply": { "model": "concoction:custom/saponaria_stage1", "x": 90 } },
    { "when": { "age": "1", "south": "true" }, "apply": { "model": "concoction:custom/saponaria_stage1", "x": 90, "y": 180 } },
    { "when": { "age": "1", "west": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage1", "x": 90, "y": 270 } },
    { "when": { "age": "1", "east": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage1", "x": 90, "y": 90 } },

    { "when": { "age": "2", "up": "true"    }, "apply": { "model": "concoction:custom/saponaria_stage2" } },
    { "when": { "age": "2", "down": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage2", "x": 180 } },
    { "when": { "age": "2", "north": "true" }, "apply": { "model": "concoction:custom/saponaria_stage2", "x": 90 } },
    { "when": { "age": "2", "south": "true" }, "apply": { "model": "concoction:custom/saponaria_stage2", "x": 90, "y": 180 } },
    { "when": { "age": "2", "west": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage2", "x": 90, "y": 270 } },
    { "when": { "age": "2", "east": "true"  }, "apply": { "model": "concoction:custom/saponaria_stage2", "x": 90, "y": 90 } }
  ]
}
